*{box-sizing:border-box}html,body,#root{margin:0;width:100%;height:100%;font-family:Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,Arial,sans-serif;color:#102033}button,input{font:inherit}.app{height:100%;display:grid;grid-template-rows:64px 1fr 34px;background:#edf4f8}.topbar{display:flex;align-items:center;justify-content:space-between;padding:0 18px;background:rgba(255,255,255,.96);border-bottom:1px solid #dbe5ec;z-index:20}.brand{font-size:19px;font-weight:950;letter-spacing:1.2px}.brand span{color:#087ff5}.subtitle{font-size:10px;color:#738297;margin-top:2px}.top-actions{display:flex;align-items:center;gap:8px}.status{font-size:10px;font-weight:900;padding:7px 10px;border-radius:999px;background:#eef2f6;color:#617084}.status.live{background:#e6f8ee;color:#16804d}.icon-btn{width:34px;height:34px;border:1px solid #d9e2e9;background:white;border-radius:10px;cursor:pointer}.workspace{min-height:0;display:grid;grid-template-columns:minmax(0,1fr) 350px}.map-wrap{position:relative;min-width:0;overflow:hidden}.panel{background:#fff;border-left:1px solid #dbe5ec;overflow:auto;padding:18px}.searchbox{position:absolute;left:18px;top:18px;width:min(440px,calc(100% - 36px));height:50px;background:rgba(255,255,255,.97);border:1px solid #d7e2e9;border-radius:15px;box-shadow:0 10px 30px rgba(24,52,74,.14);display:flex;align-items:center;padding:0 12px;z-index:8}.searchbox span{font-size:22px;color:#087ff5;margin-right:8px}.searchbox input{border:0;outline:0;flex:1;background:transparent;font-size:14px}.searchbox button{border:0;background:#eef3f7;border-radius:8px;width:26px;height:26px;cursor:pointer;color:#647487}.results{position:absolute;left:18px;top:76px;width:min(440px,calc(100% - 36px));max-height:440px;overflow:auto;background:white;border:1px solid #d7e2e9;border-radius:14px;box-shadow:0 15px 38px rgba(24,52,74,.18);z-index:9;padding:5px}.results-title{padding:10px 10px 7px;font-size:10px;text-transform:uppercase;font-weight:950;letter-spacing:1px;color:#087ff5}.result{width:100%;border:0;border-radius:10px;background:white;display:flex;align-items:center;justify-content:space-between;text-align:left;padding:11px 10px;cursor:pointer}.result:hover{background:#eef8ff}.result b{display:block;font-size:13px}.result small{display:block;color:#7a8999;font-size:10px;margin-top:3px}.result>span:last-child{font-size:22px;color:#a1afbb}.quick-row{display:flex;gap:5px;flex-wrap:wrap;padding:5px 7px 9px;border-bottom:1px solid #edf1f4}.quick-row span{width:100%;font-size:9px;color:#8b98a5;text-transform:uppercase;font-weight:900}.quick-row button{border:1px solid #dce7ef;background:#f7fafc;color:#31465a;border-radius:999px;padding:6px 9px;font-size:10px;cursor:pointer}.empty{padding:22px;color:#8a97a4;text-align:center;font-size:12px}.floor-picker{position:absolute;right:18px;top:18px;z-index:7;display:flex;gap:5px;padding:5px;background:rgba(255,255,255,.92);border:1px solid #d9e4eb;border-radius:14px;box-shadow:0 8px 25px rgba(24,52,74,.1)}.floor-picker button{border:0;background:transparent;border-radius:9px;padding:7px 9px;cursor:pointer;color:#667789}.floor-picker button.active{background:#087ff5;color:white}.floor-picker b{display:block;font-size:11px}.floor-picker small{font-size:8px}.map-tools{position:absolute;left:18px;bottom:18px;z-index:7;display:flex;gap:6px;flex-wrap:wrap}.map-tools button{border:1px solid #d7e1e8;background:rgba(255,255,255,.94);padding:9px 11px;border-radius:10px;color:#3d5266;font-size:10px;font-weight:800;box-shadow:0 6px 20px rgba(20,45,66,.1);cursor:pointer}.map-tools button:disabled{opacity:.45;cursor:not-allowed}.welcome,.destination{padding:4px}.icon{width:48px;height:48px;display:grid;place-items:center;background:#e9f5ff;color:#087ff5;border-radius:14px;font-size:25px;margin-bottom:15px}.eyebrow{font-size:9px;font-weight:950;letter-spacing:1.2px;color:#087ff5}.welcome h2,.destination h2{font-size:25px;line-height:1.1;margin:7px 0}.welcome p,.destination p{font-size:12px;line-height:1.6;color:#718092}.primary,.walk-btn,.secondary,.stop-btn{border:0;border-radius:11px;padding:11px 13px;font-size:11px;font-weight:900;cursor:pointer}.primary{background:#087ff5;color:white;box-shadow:0 8px 18px rgba(8,127,245,.2)}.walk-btn{background:#102033;color:#fff}.secondary{background:#edf3f7;color:#31475b}.dest-actions,.nav-actions{display:flex;gap:7px;flex-wrap:wrap;margin-top:15px}.feature-grid{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:18px}.feature-grid span{background:#f5f8fa;border:1px solid #e2e9ee;border-radius:9px;padding:9px;font-size:10px;color:#536679}.nav-card,.location-card,.utility-card,.qr-panel,.admin{margin-top:16px;border:1px solid #dfe8ee;border-radius:14px;padding:13px;background:#fbfdfe}.nav-live{font-size:9px;font-weight:950;color:#087ff5;display:flex;align-items:center;gap:6px}.pulse{width:7px;height:7px;border-radius:50%;background:#0bb66f;box-shadow:0 0 0 4px #dcf7eb}.nav-card>strong{display:block;margin-top:12px;font-size:16px}.nav-meta{font-size:11px;color:#728092;margin-top:4px}.route-floors{display:flex;gap:5px;flex-wrap:wrap;margin-top:10px}.route-floors span{font-size:9px;padding:5px 7px;background:#e9f5ff;color:#087ff5;border-radius:7px;font-weight:900}.next-step{margin-top:12px;padding:11px;background:#eef8ff;border-radius:10px;border-left:3px solid #087ff5}.next-step span{font-size:8px;font-weight:900;color:#087ff5;display:block}.next-step b{font-size:13px;display:block;margin-top:2px}.next-step small{color:#708092}.stop-btn{background:#ffe9e8;color:#a72f29}.location-card{display:flex;align-items:center;justify-content:space-between}.location-card b,.location-card span{display:block}.location-card b{font-size:11px}.location-card span{font-size:9px;color:#7b8997;margin-top:3px}.location-card button{border:0;background:#edf3f7;padding:7px 9px;border-radius:8px;font-size:9px;font-weight:900;cursor:pointer}.utility-card{display:grid;gap:6px}.utility-card button{border:0;background:white;border:1px solid #e5ebef;border-radius:9px;padding:9px;text-align:left;cursor:pointer;font-size:10px;font-weight:800}.utility-card small{float:right;color:#8b98a5}.admin h3{font-size:12px;margin:0 0 12px}.admin label{display:block;font-size:10px;color:#5c6e7f;margin:11px 0}.admin input[type=range]{width:100%}.warning{margin-top:14px;background:#fff8e7;border:1px solid #f1dfaa;border-radius:9px;padding:9px;font-size:9px;color:#735b20}.warning ul{padding-left:17px;margin-bottom:0}.qr-panel p{font-size:10px;color:#718092;line-height:1.5}.qr-panel button{border:1px solid #dfe8ee;background:white;border-radius:8px;padding:7px;margin:3px;font-size:9px;cursor:pointer}.walk-hud{position:absolute;left:50%;top:18px;transform:translateX(-50%);z-index:8;background:rgba(8,22,35,.9);color:white;border:1px solid rgba(255,255,255,.16);border-radius:15px;display:flex;align-items:center;gap:18px;padding:10px 13px;backdrop-filter:blur(12px);box-shadow:0 10px 30px rgba(0,0,0,.2);min-width:min(620px,calc(100% - 36px))}.walk-hud strong{display:block;color:#62b8ff;font-size:9px;letter-spacing:1px}.walk-hud span{font-size:11px}.instruction{flex:1;border-left:1px solid rgba(255,255,255,.15);padding-left:15px}.instruction b{font-size:13px}.instruction small{display:block;color:#a9b9c7;font-size:9px;margin-top:2px}.hud-distance{font-size:18px;font-weight:950}.game-controls{position:absolute;left:50%;bottom:24px;transform:translateX(-50%);display:grid;grid-template-columns:64px 76px 64px;grid-template-rows:64px 54px;gap:6px;z-index:9}.game-controls button{border:1px solid rgba(255,255,255,.22);background:rgba(9,25,39,.84);color:white;border-radius:18px;font-size:25px;font-weight:950;cursor:pointer;box-shadow:0 10px 25px rgba(0,0,0,.25);backdrop-filter:blur(10px)}.game-controls button.forward{background:#087ff5}.game-controls button:nth-child(1){grid-column:1}.game-controls button:nth-child(2){grid-column:2}.game-controls button:nth-child(3){grid-column:3}.game-controls button:nth-child(4){grid-column:2}.game-controls small{display:block;font-size:7px;letter-spacing:.7px}.outside{position:absolute;left:50%;top:84px;transform:translateX(-50%);z-index:10;background:#fff6dd;border:1px solid #eedb9e;color:#70571e;border-radius:11px;padding:9px 12px;font-size:10px;box-shadow:0 8px 20px rgba(30,65,90,.13)}.outside button{border:0;background:#70571e;color:white;border-radius:7px;padding:5px 7px;margin-left:7px;font-size:9px}.map-label{background:#102033;color:white;padding:4px 7px;border-radius:7px;font-size:8px;white-space:nowrap}.map-label.active{background:#087ff5}.user-label{background:#087ff5;color:white;padding:3px 6px;border-radius:6px;font-size:8px;font-weight:900}footer{display:flex;align-items:center;justify-content:space-between;padding:0 16px;background:white;border-top:1px solid #dbe5ec;color:#708092;font-size:9px;z-index:20}
@media(max-width:900px){.workspace{grid-template-columns:1fr}.panel{position:absolute;z-index:12;right:8px;top:78px;width:min(330px,calc(100% - 16px));max-height:calc(100% - 120px);border:1px solid #dbe5ec;border-radius:15px;box-shadow:0 15px 35px rgba(20,45,66,.18);padding:14px}.subtitle{display:none}.searchbox{left:10px;top:10px;width:calc(100% - 20px)}.results{left:10px;top:68px;width:calc(100% - 20px)}.floor-picker{right:10px;top:74px}.map-tools{left:10px;bottom:10px;max-width:calc(100% - 20px)}.map-tools button{padding:8px}.walk-hud{top:10px;min-width:calc(100% - 20px);gap:10px}.hud-distance{font-size:14px}.game-controls{bottom:15px}.game-controls button{width:auto}.topbar{height:58px}footer{font-size:8px}}

.mode-switch{display:flex;background:#eef3f7;border:1px solid #d7e1e8;border-radius:10px;padding:3px;gap:2px}.mode-switch button{border:0;background:transparent;border-radius:7px;padding:6px 9px;font-size:9px;font-weight:950;color:#718092;cursor:pointer}.mode-switch button.active{background:#102033;color:white;box-shadow:0 3px 9px rgba(16,32,51,.15)}.map-tools .selected-tool{background:#087ff5;color:white;border-color:#087ff5}.admin-head{display:flex;align-items:center;justify-content:space-between;gap:10px}.admin-head h3{margin:3px 0 0}.admin-note{font-size:9px;line-height:1.45;color:#718092;background:#f4f8fb;border-radius:8px;padding:8px}.editor-list{margin-top:15px;border-top:1px solid #e6edf2;padding-top:10px}.editor-list>b{display:block;font-size:10px;margin-bottom:8px}.editor-row{display:grid;grid-template-columns:45px 1fr auto;gap:5px;align-items:center;margin:5px 0}.editor-row span{font-size:7px;color:#8a97a4;overflow:hidden;white-space:nowrap}.editor-row input{min-width:0;border:1px solid #d9e3e9;border-radius:7px;padding:6px 7px;font-size:9px;outline:none}.editor-row input:focus{border-color:#087ff5;box-shadow:0 0 0 2px rgba(8,127,245,.1)}.editor-row button{border:0;background:#f0f4f7;color:#607183;border-radius:7px;padding:6px;font-size:8px;cursor:pointer}.full{width:100%;margin-top:9px}.admin{max-height:54vh;overflow:auto}.admin::-webkit-scrollbar{width:5px}.admin::-webkit-scrollbar-thumb{background:#cbd7df;border-radius:9px}

/* V8 2D floor-plan navigation */
.plan2d{position:absolute;inset:0;overflow:hidden;background:#dfeaf1;cursor:grab;touch-action:none}
.plan2d:active{cursor:grabbing}
.plan-canvas{position:absolute;width:min(88vw,900px);height:min(88vw,900px);min-width:620px;min-height:620px;left:50%;top:50%;margin-left:min(-44vw,-450px);margin-top:min(-44vw,-450px);transform-origin:center;will-change:transform;box-shadow:0 18px 50px rgba(23,48,68,.18);border-radius:10px;overflow:hidden;background:white}
.plan-image{position:absolute;inset:0;width:100%;height:100%;object-fit:fill;user-select:none;pointer-events:none}
.plan-overlay{position:absolute;inset:0;width:100%;height:100%;overflow:visible;pointer-events:none}
.plan-route-shadow{fill:none;stroke:rgba(0,76,180,.22);stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.plan-route{fill:none;stroke:#087ff5;stroke-width:1.05;stroke-linecap:round;stroke-linejoin:round;filter:drop-shadow(0 2px 2px rgba(0,60,150,.3))}
.plan-pin{position:absolute;transform:translate(-50%,-50%);border:0;background:transparent;padding:0;cursor:pointer;z-index:4;color:#172b3d;text-shadow:0 1px 2px white,0 -1px 2px white}
.plan-pin span{display:grid;place-items:center;width:16px;height:16px;border-radius:50%;background:#fff;border:2px solid #087ff5;color:#087ff5;font-size:8px;box-shadow:0 2px 7px rgba(10,60,100,.28);margin:auto}
.plan-pin b{display:block;max-width:110px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:8px;margin-top:2px;font-weight:850}
.plan-pin.selected span{width:21px;height:21px;background:#087ff5;color:#fff;border-color:#fff;box-shadow:0 0 0 4px rgba(8,127,245,.2),0 4px 12px rgba(8,127,245,.35)}
.plan-pin.selected b{background:#102033;color:#fff;text-shadow:none;border-radius:5px;padding:3px 5px}
.plan-user-dot{position:absolute;transform:translate(-50%,-50%);z-index:8;text-align:center;pointer-events:none}
.plan-user-dot span{display:block;width:18px;height:18px;border-radius:50%;background:#087ff5;border:3px solid white;box-shadow:0 0 0 7px rgba(8,127,245,.2),0 4px 12px rgba(8,60,100,.35)}
.plan-user-dot b{display:block;margin-top:4px;background:#087ff5;color:#fff;padding:3px 5px;border-radius:5px;font-size:7px;letter-spacing:.5px}
.plan-zoom{position:absolute;right:18px;bottom:18px;display:flex;flex-direction:column;align-items:center;background:rgba(255,255,255,.96);border:1px solid #d4e0e7;border-radius:12px;overflow:hidden;box-shadow:0 8px 24px rgba(20,45,66,.13);z-index:10}
.plan-zoom button{border:0;background:white;width:38px;height:36px;font-size:18px;color:#29465d;cursor:pointer}
.plan-zoom button:hover{background:#eef7ff;color:#087ff5}
.plan-zoom span{font-size:8px;font-weight:900;color:#7a8997;padding:5px 0;border-top:1px solid #edf1f4;border-bottom:1px solid #edf1f4;width:100%;text-align:center}
.plan-help{position:absolute;left:18px;bottom:18px;z-index:10;background:rgba(255,255,255,.94);border:1px solid #d8e3ea;border-radius:11px;padding:9px 11px;box-shadow:0 7px 20px rgba(20,45,66,.1)}
.plan-help b{display:block;font-size:9px;color:#087ff5;letter-spacing:.8px}.plan-help span{display:block;font-size:9px;color:#718092;margin-top:3px}
.map-wrap:has(.plan2d) .map-tools{bottom:18px}
@media(max-width:900px){.plan-canvas{width:88vw;height:88vw;min-width:520px;min-height:520px;margin-left:-44vw;margin-top:-44vw}.plan-help{left:10px;bottom:78px}.plan-zoom{right:10px;bottom:78px}.plan-pin b{font-size:7px;max-width:80px}}

/* V9 focused walking UI: fewer competing elements, stronger corridor guidance */
.destination-3d-label{display:flex;flex-direction:column;align-items:center;gap:2px;min-width:120px;padding:7px 10px;border-radius:12px;background:rgba(8,127,245,.96);color:#fff;box-shadow:0 8px 24px rgba(0,70,140,.28);pointer-events:none;white-space:nowrap}
.destination-3d-label span{font-size:9px;font-weight:800;letter-spacing:.12em;opacity:.78}
.destination-3d-label b{font-size:12px;font-weight:750}
.panel-walking{opacity:.96}
.panel-walking .welcome,.panel-walking .location-card,.panel-walking .utility-card,.panel-walking .admin,.panel-walking .destination .secondary{display:none}
.panel-walking .destination{padding-bottom:8px}
.panel-walking .nav-card{margin-top:8px}
.panel-walking .nav-actions{grid-template-columns:1fr 1fr}
.walk-hud{left:24px;right:24px;bottom:92px;display:flex;align-items:center;gap:16px;padding:13px 16px;border:1px solid rgba(255,255,255,.6);border-radius:16px;background:rgba(10,27,43,.84);backdrop-filter:blur(14px);box-shadow:0 12px 34px rgba(0,0,0,.18);color:#fff}
.walk-hud>div:first-child{min-width:130px;display:flex;flex-direction:column;gap:2px}.walk-hud>div:first-child strong{font-size:10px;letter-spacing:.12em;color:#7ec2ff}.walk-hud>div:first-child span{font-size:14px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:190px}
.walk-hud .instruction{flex:1;display:flex;flex-direction:column;gap:2px}.walk-hud .instruction b{font-size:16px}.walk-hud .instruction small{opacity:.68}.hud-distance{font-size:22px;font-weight:800;min-width:64px;text-align:right}
.game-controls{right:24px;bottom:24px;left:auto;display:grid;grid-template-columns:repeat(4,68px);gap:8px}.game-controls button{height:60px;border-radius:15px;background:rgba(9,28,44,.9);border:1px solid rgba(255,255,255,.14);color:#fff;box-shadow:0 8px 20px rgba(0,0,0,.16);font-size:22px}.game-controls button.forward{background:#087ff5;border-color:#087ff5}.game-controls small{display:block;font-size:8px;letter-spacing:.1em;margin-top:2px;opacity:.72}
.map-wrap:has(.walk-hud) .searchbox,.map-wrap:has(.walk-hud) .results,.map-wrap:has(.walk-hud) .floor-picker{opacity:.78;transform:scale(.96);transform-origin:top left}
.map-wrap:has(.walk-hud) .floor-picker{bottom:24px;left:24px}
@media(max-width:900px){.walk-hud{left:12px;right:12px;bottom:165px}.game-controls{left:12px;right:12px;bottom:12px;grid-template-columns:repeat(4,1fr)}.panel-walking{display:none}.walk-hud .hud-distance{display:none}}

/* V10 mode controls */
.mode-switch{display:flex;gap:6px;align-items:center}
.mode-switch button{border:1px solid rgba(20,45,70,.12);background:#fff;padding:8px 11px;border-radius:10px;font-weight:800;font-size:11px;letter-spacing:.04em;cursor:pointer}
.mode-switch button.active{background:#087ff5;color:#fff;border-color:#087ff5}
.status.demo{background:#eef7ff;color:#087ff5}
.location-actions{display:flex;gap:6px}
.location-actions button{white-space:nowrap}
.modal-backdrop{position:fixed;inset:0;background:rgba(8,20,35,.48);backdrop-filter:blur(6px);z-index:1000;display:grid;place-items:center;padding:20px}
.admin-login{width:min(420px,94vw);background:#fff;border-radius:22px;padding:26px;box-shadow:0 24px 80px rgba(0,0,0,.25);display:flex;flex-direction:column;gap:12px}
.admin-login h2{margin:0;font-size:28px}.admin-login p{margin:0;color:#64748b;line-height:1.5}.admin-login input{width:100%;box-sizing:border-box;border:1px solid #d7e0ea;border-radius:12px;padding:13px 14px;font-size:18px;letter-spacing:.2em}.admin-login .full{width:100%}.admin-login small{color:#64748b;text-align:center}.login-error{color:#c62828;background:#fff1f1;border-radius:10px;padding:9px 11px;font-size:13px;font-weight:700}

/* V11 immersive POV controls */
.pov-look-zone{position:absolute;inset:0;z-index:6;cursor:grab;touch-action:none;user-select:none}
.pov-look-zone:active{cursor:grabbing}
.pov-crosshair{position:absolute;left:50%;top:50%;width:18px;height:18px;transform:translate(-50%,-50%);opacity:.72;pointer-events:none}
.pov-crosshair i:first-child{position:absolute;left:8px;top:1px;width:2px;height:16px;background:rgba(255,255,255,.9);box-shadow:0 0 3px rgba(0,0,0,.65)}
.pov-crosshair i:last-child{position:absolute;left:1px;top:8px;width:16px;height:2px;background:rgba(255,255,255,.9);box-shadow:0 0 3px rgba(0,0,0,.65)}
.pov-help{position:absolute;left:50%;top:74px;transform:translateX(-50%);padding:6px 10px;border-radius:999px;background:rgba(7,21,34,.62);color:rgba(255,255,255,.82);font-size:9px;font-weight:800;letter-spacing:.08em;backdrop-filter:blur(8px);pointer-events:none}
.map-wrap:has(.pov-look-zone) .searchbox,.map-wrap:has(.pov-look-zone) .results,.map-wrap:has(.pov-look-zone) .floor-picker{display:none}
.map-wrap:has(.pov-look-zone) canvas{cursor:grab}
.map-wrap:has(.pov-look-zone) .walk-hud{top:18px;bottom:auto;left:50%;right:auto;transform:translateX(-50%);width:min(720px,calc(100% - 40px));min-width:0}
.map-wrap:has(.pov-look-zone) .game-controls{right:24px;bottom:24px;left:auto;grid-template-columns:repeat(5,60px)}
.map-wrap:has(.pov-look-zone) .map-tools{left:24px;bottom:24px}
@media(max-width:900px){.pov-help{top:84px;font-size:8px}.map-wrap:has(.pov-look-zone) .walk-hud{width:calc(100% - 24px);top:10px}.map-wrap:has(.pov-look-zone) .game-controls{left:10px;right:10px;bottom:10px;grid-template-columns:repeat(5,1fr)}.map-wrap:has(.pov-look-zone) .map-tools{left:10px;bottom:88px}.game-controls button{height:56px}}
